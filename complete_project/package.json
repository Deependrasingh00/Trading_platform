{
  "name": "cryptox-platform",
  "version": "1.0.0",
  "description": "Unified Crypto Trading Platform (Vite + Node/Express)",
  "scripts": {
    "install-backend": "npm install --prefix backend",
    "install-frontend": "npm install --prefix vite-project",
    "build-frontend": "npm run build --prefix vite-project",
    "install-all": "npm run install-backend && npm run install-frontend",
    "build": "npm run build-frontend",
    "start": "npm run start --prefix backend"
  }
}
